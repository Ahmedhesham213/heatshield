# HeatShield Backend Environment Configuration
# Copy this file to .env and fill in your values

# FortyGuard API Key (required for live mode)
# Get yours at https://fortyguard.com
FORTYGUARD_API_KEY=

# FortyGuard Base URL (usually don't need to change)
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Data mode: true = deterministic mock data, false = real FortyGuard API
# Auto-detected if not set (uses mock if no API key configured)
USE_MOCK=false

# Polling configuration
FORTYGUARD_POLL_INTERVAL=3.0
FORTYGUARD_TIMEOUT=90.0
FORTYGUARD_REQUEST_TIMEOUT=15
FORTYGUARD_CACHE_TTL=300

# CORS origins (comma-separated, default is *)
# CORS_ORIGINS=http://localhost:3000,https://yourapp.vercel.app
